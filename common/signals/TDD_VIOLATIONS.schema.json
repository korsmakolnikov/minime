{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TDD_VIOLATIONS",
  "description": "martin's TDD audit findings on unclebob's commits; kent sends them to joshua, which logs them for argyris.",
  "type": "object",
  "required": ["violations"],
  "additionalProperties": false,
  "properties": {
    "violations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent", "clause", "evidence", "severity", "note"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^M-[0-9]{8}-[0-9]{6}-[1-9][0-9]*$"},
          "agent": {"const": "unclebob"},
          "clause": {"type": "string", "minLength": 1, "description": "The rule, quoted from unclebob.agent.md."},
          "evidence": {"type": "string", "minLength": 1, "description": "Commit hashes and phases, file:line when it is about content."},
          "severity": {"enum": ["major", "minor"]},
          "note": {"type": "string", "minLength": 1, "description": "One sentence, what happened."}
        }
      }
    }
  }
}
