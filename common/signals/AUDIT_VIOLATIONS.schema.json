{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AUDIT_VIOLATIONS",
  "description": "joshua's audit findings on an agent's block; kent prints them and carries on.",
  "type": "object",
  "required": ["violations"],
  "additionalProperties": false,
  "properties": {
    "violations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent", "clause", "evidence", "severity", "note"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^V-[0-9]{8}-[0-9]{6}-[1-9][0-9]*$"},
          "agent": {"type": "string", "pattern": "^[a-z]+ \\(.+\\)$", "description": "The name and the agent id: \"unclebob (abc123)\"."},
          "clause": {"type": "string", "minLength": 1, "description": "The rule, quoted from its file or prompt."},
          "evidence": {"type": "string", "minLength": 1, "description": "Commit, file:line, log line, or event timestamp and tool call id."},
          "severity": {"enum": ["critical", "major", "minor"]},
          "note": {"type": "string", "minLength": 1, "description": "One sentence, what happened."}
        }
      }
    }
  }
}
