#!/usr/bin/env python3
"""The agents' violation log, kept in kent-errors.jsonl and shared with argyris.

Usage:
  audit-log append <<'AUDIT'   joshua and martin: append entries (stdin), never rewrite
  ...
  AUDIT
  audit-log pending            the ids still pending, oldest first
  audit-log show <id>...       print those entries whole
  audit-log handled <id>... --reason "<applied: file | no change: why | duplicate of <id>>"
                               argyris: mark them settled
  audit-log archive            argyris: when nothing is pending, move the errors
                               log to kent-errors.jsonl.prev (the last one only)
  audit-log repos              argyris: every repository with logs, and how
                               many violations each has pending

Each command reads the log of the current repository; `--repo <name>` (after
the command) reads another's, `--repo <path>` a state folder (kent-loop's).

An entry starts with a heading `## <id> — <severity> — <agent> (<agent id>)`,
the id `V-<YYYYMMDD>-<HHMMSS>-<n>` (joshua) or `M-…` (martin's TDD
violations). Each entry is one row of kind "violation" in the errors log,
beside the guard's refusals and the failed signals; it is pending until a
row of kind "handled" names it.
"""
import json
import os
import re
import sys

sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
                os.path.expanduser("~/.local/share/minime/lib")]
from minime import (ERRORS_LOG, STATE_DIR, ToolError, append_jsonl, main_guard, now, read_stdin,  # noqa: E402
                    repos, take_repo)

LOG = ERRORS_LOG
STATE = STATE_DIR
ID = r"[VM]-\d{8}-\d{6}-\d+"
HEADING = re.compile(rf"^## ({ID}) — (critical|major|minor) — (\S+)(?: \(([^)]*)\))?")
HANDLED = re.compile(rf"^HANDLED ({ID})\b(?: — (.*))?")


def rows(path=None):
    path = path or LOG
    out = []
    if os.path.exists(path):
        with open(path) as log:
            for line in log:
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    return out


def split(text):
    """The entries of a Markdown text, as (heading match, entry text)."""
    out, current = [], None
    for line in text.splitlines(keepends=True):
        match = HEADING.match(line)
        if match:
            current = [match, ""]
            out.append(current)
        elif line.startswith("## "):
            current = None
        if current:
            current[1] += line
    return out


def violation(match, text):
    return {"time": now(), "kind": "violation", "id": match.group(1), "severity": match.group(2),
            "agent": match.group(3), "agent_id": match.group(4), "entry": text.rstrip("\n") + "\n"}


def merge_legacy():
    """The Markdown log of earlier versions (joshua.log, joshua-violations.md),
    moved into the errors log: Copilot's under /tmp included."""
    for path in (os.path.join(STATE, "joshua.log"), os.path.join(STATE, "joshua-violations.md")):
        if not os.path.exists(path):
            continue
        text = open(path).read()
        for match, entry in split(text):
            append_jsonl(LOG, violation(match, "".join(
                line for line in entry.splitlines(keepends=True) if not HANDLED.match(line))))
        for line in text.splitlines():
            if (m := HANDLED.match(line)):
                append_jsonl(LOG, {"time": now(), "kind": "handled", "id": m.group(1),
                                          "reason": m.group(2) or ""})
        os.remove(path)


def entries(path=None):
    return {r["id"]: r for r in rows(path) if r.get("kind") == "violation"}


def pending(path=None):
    handled = {r["id"] for r in rows(path) if r.get("kind") == "handled"}
    return [i for i in entries(path) if i not in handled]


def main():
    args = sys.argv[1:]
    if args in ([], ["-h"], ["--help"]):
        print(__doc__.strip())
        return 0 if args else 2
    global LOG, STATE
    args, other = take_repo(args)
    if other:
        STATE, LOG = other, os.path.join(other, "kent-errors.jsonl")
    archive = LOG + ".prev"
    command, rest = args[0], args[1:]
    if command == "repos" and not rest:
        for name, folder in repos():
            print(f"{name}: {len(pending(os.path.join(folder, 'kent-errors.jsonl')))} pending")
        return 0
    merge_legacy()
    if command == "append" and not rest:
        text = read_stdin("the entries")
        headings = [line for line in text.splitlines() if line.startswith("## ")]
        bad = [h for h in headings if not HEADING.match(h)]
        if not headings or bad:
            raise ToolError("every entry starts with `## <V-YYYYMMDD-HHMMSS-n> — <critical|major|minor> — "
                            f"<agent> (<id>)`; wrong headings: {bad or 'none found'}")
        known = entries()
        found = split(text)
        again = [m.group(1) for m, _ in found if m.group(1) in known]
        if again:
            raise ToolError(f"ids already in the log: {', '.join(again)}")
        for match, entry in found:
            append_jsonl(LOG, violation(match, entry))
        print(f"appended {len(found)} entr{'y' if len(found) == 1 else 'ies'}")
    elif command == "pending" and not rest:
        print("\n".join(pending()) or "nothing pending")
    elif command == "show" and rest:
        found = entries()
        missing = [i for i in rest if i not in found]
        if missing:
            raise ToolError(f"no such entries: {', '.join(missing)}")
        sys.stdout.write("\n".join(found[i]["entry"] for i in rest))
    elif command == "handled" and rest:
        if "--reason" not in rest or rest.index("--reason") + 1 >= len(rest):
            raise ToolError('handled needs --reason "<applied: file | no change: why | duplicate of <id>>"')
        at = rest.index("--reason")
        reason, ids = " ".join(rest[at + 1:]), rest[:at]
        known = entries()
        missing = [i for i in ids if i not in known]
        if not ids or missing:
            raise ToolError(f"no such entries: {', '.join(missing) or 'none given'}")
        for i in ids:
            append_jsonl(LOG, {"time": now(), "kind": "handled", "id": i, "reason": reason})
        print(f"handled {', '.join(ids)}")
    elif command == "archive" and not rest:
        left = pending()
        if left:
            raise ToolError(f"still pending: {', '.join(left)}")
        if not os.path.exists(LOG):
            print("no log")
            return 0
        os.replace(LOG, archive)
        # an agent may have appended between the check and the move.
        late = pending(archive)
        if late:
            with open(LOG, "a") as log:
                log.write(open(archive).read())
            os.remove(archive)
            raise ToolError(f"an entry was appended meanwhile; log kept, pending: {', '.join(late)}")
        print(f"archived to {archive}")
    else:
        raise ToolError("usage: audit-log append|pending|show <id>...|handled <id>...|archive|repos [--repo <name>]")


main_guard(main)
