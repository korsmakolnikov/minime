#!/usr/bin/env python3
"""Appends to the workflow's activity log, kent-flow.log in the workflow's
state folder (see minime.state_dir; /tmp on Copilot).

Usage:
  flow-log <agent> <message...>   one line
  flow-log <agent> -              every line of stdin

Each line is stamped with the time and tagged [<agent>], so the user can
follow the whole flow with `tail -f`. The hooks log every
tool call already: use it for what a call does not show (a verdict, a
decision, the step you are at).
"""
import os
import sys

sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
                os.path.expanduser("~/.local/share/minime/lib")]
from minime import ToolError, flow_log, main_guard  # noqa: E402


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if args else 2
    if len(args) < 2:
        raise ToolError("usage: flow-log <agent> <message...> | flow-log <agent> -")
    agent = args[0]
    lines = sys.stdin.read().splitlines() if args[1:] == ["-"] else [" ".join(args[1:])]
    flow_log(agent, [line for line in lines if line.strip()])


main_guard(main)
