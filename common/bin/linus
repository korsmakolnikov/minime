#!/usr/bin/env bash
# linus: the single write path to git of the workflow agents, on Copilot CLI
# and on Claude Code alike.
# Every change is a new commit with a valid Conventional message. linus only
# commits: martin checks the order of a unit's commits with unit-audit. The
# CLIs differ only in the trailer and in the workflow's files, which Copilot
# never commits. Code-review corrections are fixups of a branch commit, or
# review commits with the user's consent.

set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'
COPILOT_EMAIL='223556219+Copilot@users.noreply.github.com'
CLAUDE_EMAIL='noreply@anthropic.com'
TRAILER_RE='^Co-[Aa]uthored-[Bb]y: (Copilot|Claude) '
TYPES='feat|fix|test|refactor|perf|docs|style|build|ci|chore|revert|benchmark'
SCOPE_RE='\(([a-z0-9._/-]+( [a-z0-9._/-]+)*)\)'
CONVENTIONAL_RE="^($TYPES)($SCOPE_RE)?!?: [^ ].*[^.]\$"
TEST_PATH_RE='(^|/)(test|tests|spec|__tests__)/|_test\.[a-z]+$|(^|/)test_[^/]*\.py$|\.(test|spec)\.[a-z]+$'
TEST_SUBJECT_RE='^test[(:!]'
BENCHMARK_SUBJECT_RE='^benchmark[(:!]'
TEST_REFACTOR_RE='^refactor\(test\)!?: '
PHASES='architecture review other'

die() {
  >&2 echo -e "${RED}$*${NC}"
  exit 1
}

usage() {
  cat <<'EOF'
Usage: linus <command> [args]

Read-only:
  base                          Print the merge-base of HEAD and the base branch.
  range                         List branch commits (<base>..HEAD), newest first,
                                with the phase recorded for each.
  check-message [-F <file>] <<'MSG'
                                Validate a message without committing.
                                Prints "ok (<n>/72)" or every problem found.

Write:
  branch <name>                 Switch to branch <name>, creating it from HEAD if it
                                does not exist. Refuses master, main and an invalid name.
  stage <path>...               git add the given paths.
  hunks <path>                  List the unstaged hunks of <path>, numbered (read only).
  stage-hunks <path> <n>...     Stage only hunks <n>... of <path>, as `linus hunks` numbers them.
  stage-patch <patch-file>      Stage only the hunks in <patch-file> (git apply --cached).
  unstage [<path>...]           Unstage paths (all if none given).
  commit [--phase <phase>] [--empty] [<path>...] <<'MSG'
                                Stage the given paths, then commit everything staged.
                                The phase is optional and only recorded; a
                                test: commit is never empty.
                                The message comes from stdin: the subject line, a
                                blank line and a body. The co-author trailer is appended.
  amend [<path>...]
                                Stage the given paths and amend HEAD, keeping its
                                message. Only a test: HEAD can be amended.
  squash --scope <scope> --from <commit> <<'MSG'
                                Replace the unit <commit>..HEAD with one commit
                                (martin, after the unit's TDD audit). Every commit
                                of the unit carries <scope> (a fixup carries that
                                of the commit it fixes) or is martin's
                                refactor(test) (or a fixup of it) or benchmark, none is a squashed
                                unit already, the commit before <commit> does not
                                carry <scope> unless it is a squashed unit, and
                                the work tree is clean. The message has the same
                                scope. The benchmark commits are dropped: the
                                tree loses only their changes. The commit is
                                recorded as a "unit".
  fixup --target <commit> [<path>...] <<'MSG'
                                Stage the given paths, then commit everything staged
                                as "fixup! <subject of <commit>>" (code review, or
                                static analysis at the close of a unit). The
                                target must lie in <base>..HEAD. Stdin holds only
                                the body; the co-author trailer is appended. The
                                commit is recorded as a "fixup"; never autosquashed.

Phases, only recorded (linus range shows them): architecture (ford's work,
scope "architecture" or that of its unit), review (a correction to code outside
the branch, with the user's consent) and other.

  commit and squash accept -F <file> instead of stdin and --model <id>. The
  co-author trailer names the agent's CLI, $LINUS_COAUTHOR: "copilot"
  (Co-authored-by: Copilot (<model>)) or "claude" (Co-Authored-By: Claude
  (<model>)); unset, "claude" inside Claude Code (CLAUDECODE=1), else
  "copilot". The model is --model, else $LINUS_MODEL, else the "model" of the
  CLI's settings.json (~/.copilot or ~/.claude). Each commit is appended to
  the activity log (kent-flow.log in the workflow's state folder: $MINIME_STATE_DIR,
  else ~/.local/state/minime/<repository> on Claude Code, else /tmp) when that
  file exists.

The base branch is $LINUS_BASE, else `git config linus.base`, else the first
existing ref among origin/master, origin/main, master, main.
EOF
}

base_ref() {
  local ref="${LINUS_BASE:-$(git config --get linus.base || true)}"
  if [ -n "$ref" ]; then
    git rev-parse --verify -q "$ref^{commit}" >/dev/null || die "Base ref '$ref' does not exist."
    echo "$ref"
    return
  fi
  for ref in origin/master origin/main master main; do
    if git rev-parse --verify -q "$ref^{commit}" >/dev/null; then
      echo "$ref"
      return
    fi
  done
  die "Cannot find a base branch. Set LINUS_BASE or 'git config linus.base'."
}

# Sets BASE once: the merge-base does not move while the branch grows.
load_base() {
  [ -n "${BASE:-}" ] || BASE=$(git merge-base "$(base_ref)" HEAD)
}

# True when the commit lies in <base>..HEAD.
in_branch() {
  git merge-base --is-ancestor "$1" HEAD && ! git merge-base --is-ancestor "$1" "$BASE"
}

current_branch_guard() {
  local branch
  branch=$(git symbolic-ref --short -q HEAD || true)
  [ -n "$branch" ] || die "Detached HEAD: refusing to write."
  case "$branch" in
  master | main) die "Refusing to commit on '$branch'. Work on a feature branch." ;;
  esac
}

phase_of() {
  awk -v s="$1" '$1 == s { p = $2 } END { print p }' "$PHASE_LOG" 2>/dev/null || true
}

record_phase() {
  mkdir -p "${PHASE_LOG%/*}"
  echo "$(git rev-parse HEAD) $1" >>"$PHASE_LOG"
}

# One line per commit of <range>, newest first: "<sha> <short> <phase> <subject>",
# with "-" for a commit whose phase was never recorded. Two processes in all,
# whatever the length of the range.
log_with_phases() {
  git log --format='%H %h %s' "$1" |
    awk -v plog="$PHASE_LOG" '
      BEGIN { while ((getline line < plog) > 0) { split(line, f, " "); p[f[1]] = f[2] } }
      { sha = $1; short = $2; sub(/^[^ ]+ [^ ]+ /, ""); print sha, short, (sha in p ? p[sha] : "-"), $0 }'
}

# The scope of a Conventional Commits subject, empty when it has none. A
# "fixup! <subject>" carries the scope of the subject it fixes.
subject_scope() {
  local subject="$1"
  while [[ "$subject" == "fixup! "* ]]; do subject="${subject#fixup! }"; done
  if [[ "$subject" =~ ^($TYPES)\(([^\)]*)\)!?:\  ]]; then echo "${BASH_REMATCH[2]}"; fi
}

# Sets COAUTHOR, the CLI the trailer names: claude or copilot.
load_coauthor() {
  COAUTHOR="${LINUS_COAUTHOR:-}"
  if [ -z "$COAUTHOR" ]; then
    if [ "${CLAUDECODE:-}" = 1 ]; then COAUTHOR=claude; else COAUTHOR=copilot; fi
  fi
  [[ "$COAUTHOR" == claude || "$COAUTHOR" == copilot ]] ||
    die "LINUS_COAUTHOR must be claude or copilot, got '$COAUTHOR'."
}

default_model() {
  local settings="${COPILOT_HOME:-$HOME/.copilot}/settings.json"
  [ "$COAUTHOR" = copilot ] || settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
  [ -f "$settings" ] || return 0
  sed -nE 's/^[[:space:]]*"model"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$settings" | head -n 1
}

# Parses --phase, --empty, --model, -F and the paths to stage; reads the
# message from stdin when there is no -F.
parse_commit_args() {
  MODEL=""
  MSG_FILE=""
  PHASE=""
  EMPTY=""
  PATHS=()
  while [ $# -gt 0 ]; do
    case "$1" in
    --model) MODEL="${2:-}"; shift 2 ;;
    --phase) PHASE="${2:-}"; shift 2 ;;
    --empty) EMPTY=1; shift ;;
    -F) MSG_FILE="${2:-}"; shift 2 ;;
    --) shift; PATHS+=("$@"); break ;;
    -*) die "Unknown option: $1" ;;
    *) PATHS+=("$1"); shift ;;
    esac
  done
  resolve_model
  [ -z "$PHASE" ] || [[ " $PHASES " == *" $PHASE "* ]] || die "Unknown phase '$PHASE'. Phases: $PHASES."

  [ "$CMD" != commit ] || read_message
}

resolve_model() {
  load_coauthor
  MODEL="${MODEL:-${LINUS_MODEL:-$(default_model)}}"
  [ -n "$MODEL" ] || die "No model: pass --model <id>, set LINUS_MODEL or a model in settings.json."
}

# Reads the message from stdin into a temporary MSG_FILE, unless -F gave one.
read_message() {
  [ -z "$MSG_FILE" ] || return 0
  [ -t 0 ] && die "The message is missing: pass it on stdin (heredoc) or with -F <file>."
  MSG_FILE=$(mktemp)
  trap 'rm -f "$MSG_FILE"' EXIT
  cat >"$MSG_FILE"
}

stage_paths() {
  [ $# -eq 0 ] || git add -- "$@"
}

report() {
  git log -1 --format='%h %s'
  git diff-tree --no-commit-id --name-only -r HEAD | sed 's/^/  /'
}

# The workflow's state folder, as minime.state_dir finds it.
state_dir() {
  if [ -n "${MINIME_STATE_DIR:-}" ]; then
    echo "$MINIME_STATE_DIR"
  elif [ "${CLAUDECODE:-}" = 1 ]; then
    echo "${XDG_STATE_HOME:-$HOME/.local/state}/minime/$(basename "$(git rev-parse --show-toplevel)")"
  else
    echo /tmp
  fi
}

flow_log() {
  local FLOW_LOG
  FLOW_LOG="$(state_dir)/kent-flow.log"
  [ -f "$FLOW_LOG" ] || return 0
  echo "$(date -Is) [linus] $1 $(git log -1 --format='%h %s')" >>"$FLOW_LOG"
}

trailer() {
  case "$COAUTHOR" in
  claude) echo "Co-Authored-By: Claude ($MODEL) <$CLAUDE_EMAIL>" ;;
  copilot) echo "Co-authored-by: Copilot ($MODEL) <$COPILOT_EMAIL>" ;;
  esac
}

# The workflow's own files: versioned on Claude Code, never on Copilot.
WORKFLOW_FILES_RE='(^|/)\.(sources|documentation)/|(^|/)toolchain\.yaml$'
WORKFLOW_PATHSPEC=(. ':!.sources' ':!.documentation' ':(exclude,glob)**/toolchain.yaml')

require_staged() {
  git diff --cached --quiet && die "Nothing is staged."
  [ -n "${COAUTHOR:-}" ] || load_coauthor
  if [ "$COAUTHOR" = copilot ] && git diff --cached --name-only | grep -qE "$WORKFLOW_FILES_RE"; then
    die "Staged changes include the workflow's files (.sources/, .documentation/, toolchain.yaml), which are never committed on Copilot. Unstage them."
  fi
  return 0
}

strip_existing_trailer() {
  grep -vE "$TRAILER_RE" "$1" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
}

message_problems() {
  local file="$1" subject blank body
  subject=$(sed -n 1p "$file")
  blank=$(sed -n 2p "$file")
  body=$(sed -n '3,$p' "$file" | grep -vE "$TRAILER_RE" | grep -v '^[[:space:]]*$' || true)
  [[ "$subject" =~ $CONVENTIONAL_RE ]] ||
    echo "Subject is not a Conventional Commit sentence without a trailing period: '$subject'"
  [ "${#subject}" -le 72 ] ||
    echo "Subject is ${#subject} characters, $((${#subject} - 72)) over the limit of 72: '$subject'"
  [ -z "$blank" ] || echo "Line 2 of the message must be blank."
  [ -n "$body" ] || echo "The message needs a body after the blank line."
  return 0
}

validate_message() {
  local file="$1" problems
  [ -f "$file" ] || die "Message file '$file' not found."
  problems=$(message_problems "$file")
  [ -z "$problems" ] || die "$problems"
}

check_message() {
  MSG_FILE=""
  while [ $# -gt 0 ]; do
    case "$1" in
    -F) MSG_FILE="${2:-}"; shift 2 ;;
    *) die "Usage: linus check-message [-F <file>] <<'MSG'" ;;
    esac
  done
  read_message
  validate_message "$MSG_FILE"
  local subject
  subject=$(sed -n 1p "$MSG_FILE")
  echo "ok (${#subject}/72)"
}

CMD="${1:-}"
[ -n "$CMD" ] || { usage; exit 1; }
shift

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not inside a git work tree."
COMMON_DIR=$(git rev-parse --git-common-dir)
PHASE_LOG="$COMMON_DIR/linus/phases"

# Write commands share the index: serialise them, so that parallel calls cannot
# mix their files into one commit.
case "$CMD" in
branch | stage | stage-hunks | stage-patch | unstage | commit | amend | squash | fixup)
  exec 9>"$COMMON_DIR/linus.lock"
  flock 9
  ;;
esac

case "$CMD" in
-h | --help | help) usage ;;
base) load_base; echo "$BASE" ;;
range)
  load_base
  while read -r _ short phase subject; do
    printf '%s [%s] %s\n' "$short" "${phase#-}" "$subject"
  done < <(log_with_phases "$BASE..HEAD")
  ;;
check-message) check_message "$@" ;;
branch)
  [ $# -eq 1 ] || die "Usage: linus branch <name>"
  git check-ref-format --branch "$1" >/dev/null 2>&1 || die "Not a valid branch name: $1"
  case "$1" in
  master | main) die "Refusing to switch to '$1'. Work on a feature branch." ;;
  esac
  if git rev-parse --verify -q "refs/heads/$1" >/dev/null; then
    git switch -q "$1"
  else
    git switch -q -c "$1"
  fi
  echo "On branch $1."
  ;;
stage)
  [ $# -ge 1 ] || die "Usage: linus stage <path>..."
  git add -- "$@"
  ;;
hunks | stage-hunks)
  [ $# -ge 1 ] || die "Usage: linus $CMD <path> [<n>...]"
  [ "$CMD" = hunks ] && [ $# -ne 1 ] && die "Usage: linus hunks <path>"
  [ "$CMD" = stage-hunks ] && [ $# -lt 2 ] && die "Usage: linus stage-hunks <path> <n>..."
  diff=$(git diff -U0 --no-color -- "$1")
  [ -n "$diff" ] || die "No unstaged changes in $1 (a new file is staged whole: linus stage)."
  if [ "$CMD" = hunks ]; then
    awk '/^@@/ { n++; print ""; print "hunk " n ": " $0; next } n { print "  " $0 }' <<<"$diff"
  else
    file=$1; shift
    for n in "$@"; do [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "Not a hunk number: $n"; done
    total=$(grep -c '^@@' <<<"$diff")
    for n in "$@"; do [ "$n" -le "$total" ] || die "$file has $total hunks, not $n (linus hunks $file)."; done
    awk -v want=" $* " '/^@@/ { n++ } !n || index(want, " " n " ") { print }' <<<"$diff" \
      | git apply --cached --unidiff-zero --whitespace=nowarn -
    echo "Staged hunks $* of $file."
  fi
  ;;
stage-patch)
  [ $# -eq 1 ] || die "Usage: linus stage-patch <patch-file>"
  git apply --cached --unidiff-zero --whitespace=nowarn "$1"
  ;;
unstage)
  if [ $# -eq 0 ]; then git reset -q; else git reset -q -- "$@"; fi
  ;;
commit)
  parse_commit_args "$@"
  current_branch_guard
  validate_message "$MSG_FILE"
  if [ -n "$EMPTY" ] && [[ "$(sed -n 1p "$MSG_FILE")" =~ $TEST_SUBJECT_RE ]]; then
    die "A test: commit is never empty: it holds the new test."
  fi
  stage_paths "${PATHS[@]}"
  if [ -n "$EMPTY" ]; then
    git diff --cached --quiet || die "--empty commits nothing: unstage the staged changes first."
  else
    require_staged
  fi
  { strip_existing_trailer "$MSG_FILE"; echo; trailer; } | git commit -q ${EMPTY:+--allow-empty} -F -
  [ -z "$PHASE" ] || record_phase "$PHASE"
  flow_log "${PHASE:-commit}"
  report
  ;;
amend)
  parse_commit_args "$@"
  current_branch_guard
  load_base
  head=$(git rev-parse HEAD)
  in_branch "$head" || die "HEAD is outside the branch: refusing to amend."
  [[ "$(git log -1 --format=%s)" =~ $TEST_SUBJECT_RE ]] || die "Only a test: HEAD can be amended."
  stage_paths "${PATHS[@]}"
  require_staged
  git commit -q --amend --no-edit
  [ -z "$PHASE" ] || record_phase "$PHASE"
  flow_log "amend ${PHASE:-test}"
  report
  ;;
squash)
  SCOPE=""
  FROM=""
  MODEL=""
  MSG_FILE=""
  while [ $# -gt 0 ]; do
    case "$1" in
    --scope) SCOPE="${2:-}"; shift 2 ;;
    --from) FROM="${2:-}"; shift 2 ;;
    --model) MODEL="${2:-}"; shift 2 ;;
    -F) MSG_FILE="${2:-}"; shift 2 ;;
    *) die "Usage: linus squash --scope <scope> --from <commit> <<'MSG'" ;;
    esac
  done
  [ -n "$SCOPE" ] && [ -n "$FROM" ] || die "Usage: linus squash --scope <scope> --from <commit> <<'MSG'"
  resolve_model
  read_message
  current_branch_guard
  validate_message "$MSG_FILE"
  [ "$(subject_scope "$(sed -n 1p "$MSG_FILE")")" = "$SCOPE" ] ||
    die "The message must carry the scope ($SCOPE): '$(sed -n 1p "$MSG_FILE")'"
  # The workflow's files may change while a unit is open; kent commits them
  # between units, so they do not count here.
  git diff --quiet -- "${WORKFLOW_PATHSPEC[@]}" && git diff --cached --quiet ||
    die "The work tree has uncommitted changes: a squash needs a clean tree (the workflow's files aside)."
  from=$(git rev-parse --verify -q "$FROM^{commit}") || die "Unknown commit '$FROM'."
  load_base
  in_branch "$from" || die "$FROM is outside the branch (<base>..HEAD)."
  [ -z "$(git rev-list --merges "$from^..HEAD")" ] || die "The unit contains merge commits."
  count=0
  BENCHMARKS=()
  while read -r sha short phase subject; do
    count=$((count + 1))
    [ "$phase" != unit ] || die "$short is a squashed unit already: start the unit after it."
    if [[ "$subject" =~ $BENCHMARK_SUBJECT_RE ]]; then
      BENCHMARKS+=("$sha")
      continue
    fi
    [ "$(subject_scope "$subject")" = "$SCOPE" ] ||
      [[ "${subject##*fixup! }" =~ $TEST_REFACTOR_RE ]] ||
      die "$short does not carry the scope ($SCOPE): '$subject'"
  done < <(log_with_phases "$from^..HEAD")
  before=$(git rev-parse "$from^")
  if in_branch "$before" &&
    [ "$(subject_scope "$(git log -1 --format=%s "$before")")" = "$SCOPE" ] &&
    [ "$(phase_of "$before")" != unit ]; then
    die "$(git rev-parse --short "$before") before $FROM also carries ($SCOPE): the unit starts earlier."
  fi
  tip=$(git rev-parse HEAD)
  git reset -q --soft "$before"
  # The benchmarks only measured the refactor: their changes leave the unit.
  for sha in "${BENCHMARKS[@]}"; do
    if ! git diff "$sha^" "$sha" | git apply -R --index --whitespace=nowarn; then
      git reset -q --hard "$tip"
      die "Cannot drop the benchmark commit $(git rev-parse --short "$sha"): a later commit changed its files. The branch is back at $(git rev-parse --short "$tip")."
    fi
  done
  if ! { strip_existing_trailer "$MSG_FILE"; echo; trailer; } | git commit -q --allow-empty -F -; then
    git reset -q --soft "$tip"
    die "The commit failed; the branch is back at $(git rev-parse --short "$tip")."
  fi
  if [ ${#BENCHMARKS[@]} -eq 0 ]; then
    [ "$(git rev-parse HEAD^{tree})" = "$(git rev-parse "$tip^{tree}")" ] ||
      die "The squashed tree differs from $(git rev-parse --short "$tip"): inspect, then 'git reset --hard $tip' restores the unit."
  else
    benchmark_files=$(for sha in "${BENCHMARKS[@]}"; do git show --name-only --format= "$sha"; done | sort -u)
    while read -r file; do
      [ -z "$file" ] || grep -qxF "$file" <<<"$benchmark_files" ||
        die "The squashed tree differs from $(git rev-parse --short "$tip") in $file, not a benchmark file: inspect, then 'git reset --hard $tip' restores the unit."
    done < <(git diff --name-only HEAD "$tip")
    echo "Dropped ${#BENCHMARKS[@]} benchmark commit(s)."
  fi
  record_phase unit
  flow_log "squash of $count commits (previous tip $(git rev-parse --short "$tip")) into"
  echo "Squashed $count commits; the previous tip $(git rev-parse --short "$tip") stays reachable in the reflog."
  report
  ;;
fixup)
  TARGET=""
  MODEL=""
  MSG_FILE=""
  PATHS=()
  while [ $# -gt 0 ]; do
    case "$1" in
    --target) TARGET="${2:-}"; shift 2 ;;
    --model) MODEL="${2:-}"; shift 2 ;;
    -F) MSG_FILE="${2:-}"; shift 2 ;;
    --) shift; PATHS+=("$@"); break ;;
    -*) die "Unknown option: $1" ;;
    *) PATHS+=("$1"); shift ;;
    esac
  done
  [ -n "$TARGET" ] || die "Usage: linus fixup --target <commit> [<path>...] <<'MSG'"
  resolve_model
  read_message
  current_branch_guard
  target=$(git rev-parse --verify -q "$TARGET^{commit}") || die "Unknown commit '$TARGET'."
  load_base
  in_branch "$target" ||
    die "$TARGET is outside the branch (<base>..HEAD): a fixup targets only branch commits. Ask the user for a distinct review commit."
  body=$(strip_existing_trailer "$MSG_FILE")
  [ -n "$(tr -d '[:space:]' <<<"$body")" ] || die "The fixup needs a body: why the change was made."
  [[ "$(sed -n 1p <<<"$body")" != fixup!* ]] || die "Stdin holds only the body: the wrapper writes the fixup! subject."
  stage_paths "${PATHS[@]}"
  require_staged
  { echo "fixup! $(git log -1 --format=%s "$target")"; echo; echo "$body"; echo; trailer; } | git commit -q -F -
  record_phase fixup
  flow_log "fixup of $(git rev-parse --short "$target")"
  report
  ;;
*) usage; exit 1 ;;
esac
