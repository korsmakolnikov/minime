#!/usr/bin/env python3
"""Lays down a new project: layout, toolchain, task runner, CI, git.

Usage:
  scaffold init                               git init and an empty "start." commit
  scaffold languages                          the supported languages and their keys
  scaffold <language> KEY=VALUE... [--dry-run] [--dir <folder>]
  scaffold verify [--dir <folder>]            run the new project's own checks
  scaffold commit [--dir <folder>] [--model <id>]
                                              commit the scaffolded files

In the project directory: the current one, or <folder> with --dir, which
the tool creates (it may exist only if empty), for a project inside an
existing repository or beside the current directory. The
templates of <language> are rendered with {{KEY}} replaced in paths and
contents; the tool refuses to overwrite a file or to leave a placeholder.
Then: `git init` and an empty "start." commit (skipped inside an existing
repository), and toolchain.yaml. For a project in a folder of a repository,
a toolchain.yaml at the repository's root names the folder (`project:`), so
that the tools find it from there; an existing one naming another project is
reported, not changed. The scaffolded files are not committed until `commit`.

`init` makes the current directory a repository with an empty "start."
commit, so that a session can take a feature branch before the scaffold.

`verify` runs the project's task runner: install the dependencies (network),
then the tests and the static checks, and reports each step.

`commit`, after a successful verify, commits every untracked file of the
project (the lock file verify wrote included) with `linus` as
"chore: scaffold the project". The workflow's files (.sources/,
.documentation/, toolchain.yaml) stay out: on Claude Code kent commits them
with the workflow's commits, on Copilot they are never versioned.
"""
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(HERE, "..", "lib"), os.path.expanduser("~/.local/share/minime/lib")]
import minime  # noqa: E402
from minime import ToolError, main_guard  # noqa: E402

TEMPLATES = os.path.join(os.path.dirname(minime.__file__), "scaffold")
PLACEHOLDER = re.compile(r"\{\{([A-Z_]+)\}\}")


def ident(name):
    out = re.sub(r"[^A-Za-z0-9_]", "_", name)
    return "_" + out if out[:1].isdigit() else out


def c_vars(v):
    v["PROJECT_IDENT"] = ident(v["PROJECT_NAME"])
    v["PROJECT_IDENT_UPPER"] = v["PROJECT_IDENT"].upper()


def python_vars(v):
    v.setdefault("PACKAGE", ident(v["PROJECT_NAME"]).lower())
    if not re.fullmatch(r"[a-z_][a-z0-9_]*", v["PACKAGE"]):
        raise ToolError(f"PACKAGE must be a lowercase Python identifier, not {v['PACKAGE']!r}")
    v.setdefault("PYTHON", "3.12")
    if not re.fullmatch(r"3\.\d+", v["PYTHON"]):
        raise ToolError(f"PYTHON must look like 3.12, not {v['PYTHON']!r}")
    v["PYTHON_TAG"] = "py" + v["PYTHON"].replace(".", "")
    repo = v.get("GITHUB_REPO", "")
    v["CI_BADGE"] = (f"[![CI](https://github.com/{repo}/actions/workflows/ci.yml/badge.svg)]"
                     f"(https://github.com/{repo}/actions/workflows/ci.yml)\n\n") if repo else ""


# language: (required keys, optional keys with defaults, derivation, toolchain.yaml)
LANGUAGES = {
    "c": (["PROJECT_NAME", "C_STANDARD", "TARGET_ARCH", "GITHUB_REPO"], {}, c_vars, None),
    "python": (["PROJECT_NAME"], {"PACKAGE": "<from the name>", "PYTHON": "3.12", "GITHUB_REPO": ""},
               python_vars, "toolchain: 1\nlanguage: python\n"),
}


def parse(pairs):
    values = {}
    for pair in pairs:
        key, sep, value = pair.partition("=")
        if not sep or not re.fullmatch(r"[A-Z_]+", key):
            raise ToolError(f"expected KEY=VALUE, got {pair!r}")
        values[key] = value
    return values


def render(text, values):
    return PLACEHOLDER.sub(lambda m: values.get(m.group(1), m.group(0)), text)


def plan(language, values):
    root = os.path.join(TEMPLATES, language)
    out = []
    for folder, _, files in os.walk(root):
        for name in sorted(files):
            source = os.path.join(folder, name)
            dest = render(os.path.relpath(source, root), values)
            text = render(open(source).read(), values)
            left = PLACEHOLDER.findall(dest + text)
            if left:
                raise ToolError(f"{dest}: unresolved placeholders {sorted(set(left))}")
            out.append((dest, text, os.stat(source).st_mode))
    return sorted(out)


def inside_repo():
    run = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True)
    return run.returncode == 0


def step(name, command):
    print(f"$ {' '.join(command)}", flush=True)
    status = subprocess.run(command).returncode
    print(f"{name}: {'ok' if status == 0 else f'failed ({status})'}", flush=True)
    return status


def verify():
    if not os.path.exists("Makefile"):
        raise ToolError("no Makefile here: run verify in a scaffolded project")
    targets = open("Makefile").read()
    failed = 0
    for target in ("install", "build", "check", "test"):
        if re.search(rf"^{target}:", targets, flags=re.M):
            failed |= step(target, ["make", target]) != 0
    return 1 if failed else 0


CI = os.path.join(".github", "workflows", "ci.yml")


def repo_root():
    return subprocess.run(["git", "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True, check=True).stdout.strip()


def root_ci(root, prefix):
    """The CI of the project at <prefix> (a folder of the repository at <root>)."""
    return os.path.join(root, ".github", "workflows", prefix.replace(os.sep, "-") + ".yml")


def ci_at_root(files, folder):
    """GitHub reads workflows only from the repository's root: move the CI of
    a project in a folder there, running every step inside the folder."""
    root = repo_root()
    prefix = os.path.relpath(os.path.abspath(folder), root)
    moved = []
    for dest, text, mode in files:
        if dest == CI:
            dest = root_ci(root, prefix)
            name, _, rest = text.partition("\n")
            # only the changes to the folder and to this workflow trigger it
            paths = f'    paths: ["{prefix}/**", "{os.path.relpath(dest, root)}"]'
            rest = re.sub(r"(?m)^(  (push|pull_request):)$", lambda m: f"{m.group(1)}\n{paths}", rest)
            text = (f"{name} {prefix}\n\ndefaults:\n  run:\n    working-directory: {prefix}\n{rest}")
        moved.append((dest, text, mode))
    return moved


WORKFLOW_FILE = re.compile(r"(^|/)\.(sources|documentation)/|(^|/)toolchain\.yaml$")


def commit(model):
    listed = subprocess.run(["git", "ls-files", "--others", "--exclude-standard", "."],
                            capture_output=True, text=True)
    if listed.returncode != 0:
        raise ToolError("not inside a git repository")
    files = [f for f in listed.stdout.splitlines() if not WORKFLOW_FILE.search(f)]
    prefix = subprocess.run(["git", "rev-parse", "--show-prefix"],
                            capture_output=True, text=True).stdout.strip().rstrip("/")
    if prefix:
        ci = os.path.relpath(root_ci(repo_root(), prefix))
        tracked = subprocess.run(["git", "ls-files", "--error-unmatch", ci], capture_output=True)
        if os.path.exists(ci) and tracked.returncode != 0:
            files.append(ci)
    if not files:
        raise ToolError("no untracked file to commit: the scaffold is committed already")
    command = ["linus", "commit", "--phase", "other", *(["--model", model] if model else []), *files]
    print(f"$ {' '.join(command)}", flush=True)
    message = ("chore: scaffold the project\n\n"
               "The layout, the task runner and the CI the scaffold tool lays down,\n"
               "with the lock file of the first install.\n")
    return subprocess.run(command, input=message, text=True).returncode


def take_option(args, name):
    """Removes `<name> <value>` from args; returns the value, or None."""
    if name not in args:
        return None
    at = args.index(name)
    if at + 1 >= len(args) or args[at + 1].startswith("-"):
        raise ToolError(f"{name} needs a value")
    value = args[at + 1]
    del args[at:at + 2]
    return value


def init_repo():
    if not shutil.which("git"):
        raise ToolError("git is not installed")
    subprocess.run(["git", "init", "-q"], check=True)
    subprocess.run(["git", "commit", "-q", "--allow-empty", "-m", "start."], check=True)
    print("git: initialised, empty commit \"start.\"")


def name_the_project(top, prefix, dry):
    """Points the toolchain.yaml at the repository's root to the project's folder."""
    path = os.path.join(top, "toolchain.yaml")
    shown = os.path.relpath(path)
    if not os.path.exists(path):
        print(("would create " if dry else "created ") + f"{shown} (project: {prefix})")
        if not dry:
            open(path, "w").write(f"toolchain: 1\nproject: {prefix}\n")
        return
    named = re.search(r"(?m)^project:\s*(\S+)", open(path).read())
    if not named or named.group(1).rstrip("/") != prefix:
        print(f"note: {shown} does not name this project: set `project: {prefix}` in it"
              " to build and test it with the toolchain tools")


def enter(folder, create):
    """Makes <folder> the current directory, creating it when asked."""
    if create:
        if os.path.isdir(folder) and os.listdir(folder):
            raise ToolError(f"{folder} exists and is not empty: refusing to scaffold into it")
        os.makedirs(folder, exist_ok=True)
    elif not os.path.isdir(folder):
        raise ToolError(f"no folder {folder}")
    os.chdir(folder)


def main():
    args = sys.argv[1:]
    if args[:1] in ([], ["-h"], ["--help"]):
        print(__doc__.strip())
        return 0 if args else 2
    folder = take_option(args, "--dir")
    model = take_option(args, "--model")
    if args == ["init"]:
        if inside_repo():
            raise ToolError("already inside a repository: nothing to initialise")
        init_repo()
        return 0
    if args in (["verify"], ["commit"]):
        if folder:
            enter(folder, create=False)
        return verify() if args == ["verify"] else commit(model)
    if args == ["languages"]:
        for name, (required, optional, _, _) in LANGUAGES.items():
            extra = " ".join(f"[{k}={d}]" for k, d in optional.items())
            print(f"{name}: " + " ".join(f"{k}=…" for k in required) + (f" {extra}" if extra else ""))
        return 0
    if not args:
        raise ToolError("missing the language (scaffold languages)")
    language, rest = args[0].lower(), args[1:]
    if language not in LANGUAGES:
        raise ToolError(f"unsupported language {language!r}: {', '.join(LANGUAGES)}")
    dry = "--dry-run" in rest
    values = parse([a for a in rest if a != "--dry-run"])
    required, optional, derive, toolchain = LANGUAGES[language]
    missing = [k for k in required if not values.get(k)]
    if missing:
        raise ToolError(f"missing {', '.join(missing)} (scaffold languages)")
    derive(values)
    files = plan(language, values)
    top = repo_root() if folder and inside_repo() else None
    if top:
        files = ci_at_root(files, folder)
        prefix = os.path.relpath(os.path.abspath(folder), top)
    # A dry run never creates the folder: a missing one holds nothing to clash with.
    fresh = bool(folder) and dry and not os.path.isdir(folder)
    if fresh:
        print(f"would create {folder}/")
    elif folder:
        enter(folder, create=not dry)
    clash = [d for d, _, _ in files if os.path.isabs(d) and os.path.exists(d)]
    clash += [] if fresh else [d for d, _, _ in files if not os.path.isabs(d) and os.path.exists(d)]
    if toolchain and not fresh and os.path.exists("toolchain.yaml"):
        clash.append("toolchain.yaml")
    if clash:
        raise ToolError(f"already present, refusing to overwrite: {', '.join(clash)}")
    for dest, text, mode in files:
        print(("would create " if dry else "created ") + os.path.relpath(dest))
        if not dry:
            os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
            with open(dest, "w") as out:
                out.write(text)
            os.chmod(dest, mode & 0o777)
    if toolchain:
        print(("would create " if dry else "created ") + "toolchain.yaml")
        if not dry:
            open("toolchain.yaml", "w").write(toolchain)
        if top:
            name_the_project(top, prefix, dry)
    if dry:
        return 0
    if inside_repo():
        print("git: inside an existing repository, no git init and no start commit")
    else:
        init_repo()
    verify_command = f"scaffold verify --dir {folder}" if folder else "scaffold verify"
    print(f"next: {verify_command} (installs the dependencies, then builds, checks and tests),"
          f" then {verify_command.replace('verify', 'commit')}")
    return 0


main_guard(main)
