{
  "version": 1,
  "hooks": {
    "permissionRequest": [
      {
        "type": "command",
        "matcher": "bash|edit|create|view|grep|glob|read",
        "bash": "python3 \"$HOME/.copilot/hooks/scripts/auto_approve.py\"",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog|agent_completed|agent_idle",
        "bash": "python3 \"$HOME/.copilot/hooks/scripts/notify.py\"",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/scripts/notify.py\"",
        "timeoutSec": 10
      }
    ]
  }
}
