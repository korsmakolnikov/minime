{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FORD_DONE",
  "description": "ford's report once the architecture is written and committed; kent hands it to unclebob.",
  "type": "object",
  "required": ["adl", "fitness", "components", "commits"],
  "additionalProperties": false,
  "properties": {
    "adl": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "The ADL files written in this session."},
    "fitness": {
      "type": "object",
      "required": ["files", "command"],
      "additionalProperties": false,
      "properties": {
        "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "command": {"type": "string", "minLength": 1, "description": "The command that runs them."}
      }
    },
    "components": {
      "type": "array",
      "description": "The components whose interfaces this session wrote or changed.",
      "items": {
        "type": "object",
        "required": ["module", "responsibility", "operations", "open_questions"],
        "additionalProperties": false,
        "properties": {
          "module": {"type": "string", "minLength": 1, "description": "The module or package."},
          "responsibility": {"type": "string", "minLength": 1},
          "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "The signatures."},
          "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "commits": {"type": "array", "items": {"$ref": "#/$defs/commit"}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40} \\S", "description": "A short hash and the subject."}
  }
}
