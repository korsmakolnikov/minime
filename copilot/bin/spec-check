#!/usr/bin/env python3
"""Validates a domain spec (.adl/spec.yaml) as the domain-spec skill defines it.

Usage: spec-check --stage domain|contracts [<path>]   (default .adl/spec.yaml)

Prints "ok" or one line per problem, exiting 1 on any problem and 2 on a usage
or parse error. The contracts stage also checks the components against the
ADL files in the spec's folder (as-is drafts excluded).
"""
import argparse
import pathlib
import re
import sys

try:
    import yaml
except ImportError:
    sys.exit("spec-check needs PyYAML (python3 -m pip install pyyaml)")

ID_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
ENTITY_RE = re.compile(r"^[A-Z][A-Za-z0-9]*$")
RELATION_KINDS = {"one_to_one", "one_to_many", "many_to_one", "many_to_many"}
PROPERTY_KINDS = {"invariant", "roundtrip", "idempotence", "metamorphic", "model", "oracle"}
PROVISIONAL_RE = re.compile(r"\b(should|for now|todo|tbd|later)\b", re.IGNORECASE)
TOP_KEYS = {"spec", "system", "entities", "relations", "constraints", "contracts", "properties"}

problems = []
ids = {}


def problem(where, message):
    problems.append(f"{where}: {message}")


def text(where, value, key):
    if not isinstance(value, str) or not value.strip():
        problem(where, f"'{key}' must be a non-empty sentence")
    elif PROVISIONAL_RE.search(value):
        problem(where, f"'{key}' has provisional wording: {value!r}")


def a_list(where, value, key, required):
    if value is None:
        if required:
            problem(where, f"'{key}' is missing")
        return []
    if not isinstance(value, list) or (required and not value):
        problem(where, f"'{key}' must be a{' non-empty' if required else ''} list")
        return []
    return value


def mapping(where, item):
    if not isinstance(item, dict):
        problem(where, "must be a mapping")
        return {}
    return item


def an_id(where, item):
    value = item.get("id")
    if not isinstance(value, str) or not ID_RE.match(value):
        problem(where, f"'id' must be kebab-case, got {value!r}")
        return
    if value in ids:
        problem(where, f"id '{value}' already used at {ids[value]}")
    else:
        ids[value] = where


def rules(where, value, key):
    for i, rule in enumerate(a_list(where, value, key, False)):
        at = f"{where}.{key}[{i}]"
        rule = mapping(at, rule)
        an_id(at, rule)
        text(at, rule.get("rule"), "rule")


def adl_components(folder):
    """Full physical paths defined in the target ADL, and those of components and libraries."""
    paths, components = set(), set()
    for path in folder.rglob("*.adl"):
        if "as-is" in path.relative_to(folder).parts:
            continue
        stack = []  # (indent, physical, full path)
        for line in path.read_text().splitlines():
            m = re.match(r"(\s*)DEFINE\s+(\w+)\s+.*?\bAS\s+([A-Za-z0-9_.]+)", line)
            if not m:
                continue
            indent, kind, physical = len(m.group(1)), m.group(2).upper(), m.group(3)
            while stack and stack[-1][0] >= indent:
                stack.pop()
            parent = stack[-1][2] if stack else ""
            if stack and physical.startswith(stack[-1][1] + "."):
                parent = stack[-2][2] if len(stack) > 1 else ""
            full = f"{parent}.{physical}" if parent else physical
            stack.append((indent, physical, full))
            paths.add(full)
            if kind in ("COMPONENT", "LIBRARY"):
                components.add(full)
    return paths, components


def component(where, value, system, adl):
    if not isinstance(value, str) or not value:
        problem(where, "'component' is missing")
        return
    segments = value.split(".")
    if segments[0] != system:
        problem(where, f"component '{value}' does not start with the system '{system}'")
    if adl is None:
        return
    paths, components = adl
    if value not in paths:
        problem(where, f"component '{value}' is not defined in the ADL")
    elif value not in components:
        problem(where, f"'{value}' is not a COMPONENT or LIBRARY in the ADL")


def main():
    parser = argparse.ArgumentParser(description="Validate a domain spec.")
    parser.add_argument("--stage", choices=["domain", "contracts"], required=True)
    parser.add_argument("path", nargs="?", default=".adl/spec.yaml")
    args = parser.parse_args()
    path = pathlib.Path(args.path)
    try:
        spec = yaml.safe_load(path.read_text())
    except (OSError, yaml.YAMLError) as error:
        print(f"{path}: {error}")
        return 2
    spec = mapping(str(path), spec)

    for key in sorted(set(spec) - TOP_KEYS):
        problem("spec", f"unknown key '{key}'")
    if spec.get("spec") != 1:
        problem("spec", "'spec' must be 1")
    system = spec.get("system")
    if not isinstance(system, str) or not re.match(r"^[a-z0-9_]+$", system or ""):
        problem("spec", "'system' must be the ADL SYSTEM physical name")

    entities = set()
    for i, entity in enumerate(a_list("spec", spec.get("entities"), "entities", True)):
        at = f"entities[{i}]"
        entity = mapping(at, entity)
        name = entity.get("name")
        if not isinstance(name, str) or not ENTITY_RE.match(name):
            problem(at, f"'name' must be PascalCase, got {name!r}")
        elif name in entities:
            problem(at, f"entity '{name}' defined twice")
        else:
            entities.add(name)
        text(at, entity.get("description"), "description")
        for j, field in enumerate(a_list(at, entity.get("fields"), "fields", True)):
            fat = f"{at}.fields[{j}]"
            field = mapping(fat, field)
            for key in ("name", "type"):
                if not isinstance(field.get(key), str) or not field.get(key):
                    problem(fat, f"'{key}' is missing")
            if "required" in field and not isinstance(field["required"], bool):
                problem(fat, "'required' must be true or false")
        rules(at, entity.get("invariants"), "invariants")

    for i, relation in enumerate(a_list("spec", spec.get("relations"), "relations", False)):
        at = f"relations[{i}]"
        relation = mapping(at, relation)
        for key in ("from", "to"):
            if relation.get(key) not in entities:
                problem(at, f"'{key}' names no entity: {relation.get(key)!r}")
        if relation.get("kind") not in RELATION_KINDS:
            problem(at, f"'kind' must be one of {', '.join(sorted(RELATION_KINDS))}")
        text(at, relation.get("description"), "description")
        rules(at, relation.get("rules"), "rules")

    rules("spec", spec.get("constraints"), "constraints")

    contracts_stage = args.stage == "contracts"
    adl = adl_components(path.parent) if contracts_stage else None
    if not contracts_stage:
        for key in ("contracts", "properties"):
            if spec.get(key):
                problem("spec", f"'{key}' belong to the contracts stage")

    for i, contract in enumerate(a_list("spec", spec.get("contracts"), "contracts", contracts_stage)):
        at = f"contracts[{i}]"
        contract = mapping(at, contract)
        an_id(at, contract)
        component(at, contract.get("component"), system, adl)
        if not isinstance(contract.get("operation"), str) or not contract.get("operation"):
            problem(at, "'operation' is missing")
        for key in ("pre", "post"):
            for j, sentence in enumerate(a_list(at, contract.get(key), key, key == "post")):
                text(f"{at}.{key}[{j}]", sentence, key)
        for j, error in enumerate(a_list(at, contract.get("errors"), "errors", False)):
            eat = f"{at}.errors[{j}]"
            error = mapping(eat, error)
            text(eat, error.get("when"), "when")
            if not isinstance(error.get("returns"), str) or not error.get("returns"):
                problem(eat, "'returns' is missing")

    for i, prop in enumerate(a_list("spec", spec.get("properties"), "properties", contracts_stage)):
        at = f"properties[{i}]"
        prop = mapping(at, prop)
        an_id(at, prop)
        component(at, prop.get("component"), system, adl)
        if prop.get("kind") not in PROPERTY_KINDS:
            problem(at, f"'kind' must be one of {', '.join(sorted(PROPERTY_KINDS))}")
        for j, var in enumerate(a_list(at, prop.get("forall"), "forall", True)):
            vat = f"{at}.forall[{j}]"
            var = mapping(vat, var)
            if not isinstance(var.get("name"), str) or not var.get("name"):
                problem(vat, "'name' is missing")
            text(vat, var.get("generator"), "generator")
        text(at, prop.get("holds"), "holds")

    if problems:
        print("\n".join(problems))
        return 1
    print("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
