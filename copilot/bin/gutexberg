#!/usr/bin/env bash
# gutexberg: the single write path to git used by the gutexberg agent.
# Every change is a new commit; the TDD cycle (red, green, refactor) is
# enforced from the phase recorded for each commit.

set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'
COPILOT_EMAIL='223556219+Copilot@users.noreply.github.com'
TYPES='feat|fix|test|refactor|perf|docs|style|build|ci|chore|revert'
SCOPE_RE='\(([a-z0-9._/-]+( [a-z0-9._/-]+)*)\)'
CONVENTIONAL_RE="^($TYPES)($SCOPE_RE)?!?: [^ ].*[^.]\$"
TEST_PATH_RE='(^|/)(test|tests|spec|__tests__)/|_test\.[a-z]+$|(^|/)test_[^/]*\.py$|\.(test|spec)\.[a-z]+$'
FLOW_LOG=/tmp/mortimer-flow.log
PHASES='red green refactor regression characterisation architecture other'

die() {
  >&2 echo -e "${RED}$*${NC}"
  exit 1
}

usage() {
  cat <<'EOF'
Usage: gutexberg <command> [args]

Read-only:
  base                          Print the merge-base of HEAD and the base branch.
  range                         List branch commits (<base>..HEAD), newest first,
                                with the phase recorded for each.
  next                          Print the phases a new commit may have now.
  check-message [-F <file>] <<'MSG'
                                Validate a message without committing.
                                Prints "ok (<n>/72)" or every problem found.

Write:
  stage <path>...               git add the given paths.
  stage-patch <patch-file>      Stage only the hunks in <patch-file> (git apply --cached).
  unstage [<path>...]           Unstage paths (all if none given).
  commit --phase <phase> [--empty] [<path>...] <<'MSG'
                                Stage the given paths, then commit everything staged.
                                The message comes from stdin: the subject line, a
                                blank line and a body. The Copilot trailer is appended.
  amend --phase <phase> [<path>...]
                                Stage the given paths (tests only) and amend HEAD,
                                keeping its message. Only a red, regression or
                                characterisation HEAD can be amended.

Phases and the TDD cycle (the last cycle commit of the branch decides):
  red, characterisation   a new test; the cycle must be closed (no cycle commit
                          yet, or the last one is a refactor)
  regression              a new test after a green that broke other tests
  green                   production code after red, regression or
                          characterisation; --empty only after characterisation
  refactor                after green or refactor; --empty when there is nothing
                          to refactor
  architecture            ford's work, scope "architecture", any time
  other                   anything else, only while the cycle is closed

  red, regression and characterisation commits hold only test files; green
  commits hold none. Cycle commits need a scope: "(<domain> <component>)", or
  "(<domain>)" for the functional flow tests.

  commit accepts -F <file> instead of stdin and --model <id>. The model named
  in the trailer is --model, else $GUTEXBERG_MODEL, else the "model" of
  ~/.copilot/settings.json. Each commit is appended to /tmp/mortimer-flow.log
  when that file exists.

The base branch is $GUTEXBERG_BASE, else `git config gutexberg.base`, else the first
existing ref among origin/master, origin/main, master, main.
EOF
}

base_ref() {
  local ref="${GUTEXBERG_BASE:-$(git config --get gutexberg.base || true)}"
  if [ -n "$ref" ]; then
    git rev-parse --verify -q "$ref^{commit}" >/dev/null || die "Base ref '$ref' does not exist."
    echo "$ref"
    return
  fi
  for ref in origin/master origin/main master main; do
    if git rev-parse --verify -q "$ref^{commit}" >/dev/null; then
      echo "$ref"
      return
    fi
  done
  die "Cannot find a base branch. Set GUTEXBERG_BASE or 'git config gutexberg.base'."
}

base() {
  git merge-base "$(base_ref)" HEAD
}

current_branch_guard() {
  local branch
  branch=$(git symbolic-ref --short -q HEAD || true)
  [ -n "$branch" ] || die "Detached HEAD: refusing to write."
  case "$branch" in
  master | main) die "Refusing to commit on '$branch'. Work on a feature branch." ;;
  esac
}

phase_log() {
  local dir
  dir="$(git rev-parse --git-common-dir)/gutexberg"
  mkdir -p "$dir"
  echo "$dir/phases"
}

phase_of() {
  awk -v s="$1" '$1 == s { p = $2 } END { print p }' "$(phase_log)" 2>/dev/null || true
}

record_phase() {
  echo "$(git rev-parse HEAD) $1" >>"$(phase_log)"
}

# The phase of the newest cycle commit in the branch, or "none".
last_cycle_phase() {
  local sha phase
  for sha in $(git rev-list "$(base)..HEAD"); do
    phase=$(phase_of "$sha")
    case "$phase" in
    red | green | refactor | regression | characterisation) echo "$phase"; return ;;
    esac
  done
  echo none
}

allowed_after() {
  case "$1" in
  none) echo "red characterisation architecture other" ;;
  red | regression) echo "green architecture" ;;
  characterisation) echo "green architecture" ;;
  green) echo "refactor regression architecture" ;;
  refactor) echo "refactor red characterisation architecture other" ;;
  esac
}

cycle_guard() {
  local phase="$1" empty="$2" last allowed label
  last=$(last_cycle_phase)
  allowed=$(allowed_after "$last")
  label="a $last commit"
  [ "$last" != none ] || label="the start of the branch"
  [[ " $allowed " == *" $phase "* ]] ||
    die "A $phase commit cannot follow $label (gutexberg range shows the phases). Allowed now: $allowed."
  if [ -n "$empty" ]; then
    [ "$phase" = refactor ] || { [ "$phase" = green ] && [ "$last" = characterisation ]; } ||
      die "--empty is only for a refactor, or for the green after a characterisation."
  fi
}

check_paths() {
  local phase="$1" files tests others
  files=$(git diff --cached --name-only)
  tests=$(grep -E "$TEST_PATH_RE" <<<"$files" || true)
  others=$(grep -vE "$TEST_PATH_RE" <<<"$files" || true)
  case "$phase" in
  red | regression | characterisation)
    [ -z "$others" ] || die "A $phase commit holds only test files. Not tests: $others" ;;
  green)
    [ -z "$tests" ] || die "A green commit holds only production code. Test files: $tests" ;;
  esac
  return 0
}

check_subject_scope() {
  local phase="$1" subject="$2"
  case "$phase" in
  architecture)
    [[ "$subject" =~ ^($TYPES)\(architecture\) ]] ||
      die "An architecture commit has the scope (architecture): '$subject'" ;;
  red | green | refactor | regression | characterisation)
    [[ "$subject" =~ ^($TYPES)$SCOPE_RE ]] ||
      die "A $phase commit needs the scope (<domain> <component>), or (<domain>) for the flow tests: '$subject'" ;;
  esac
  return 0
}

default_model() {
  local settings="${COPILOT_HOME:-$HOME/.copilot}/settings.json"
  [ -f "$settings" ] || return 0
  sed -nE 's/^[[:space:]]*"model"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$settings" | head -n 1
}

# Parses --phase, --empty, --model, -F and the paths to stage; reads the
# message from stdin when there is no -F.
parse_commit_args() {
  MODEL=""
  MSG_FILE=""
  PHASE=""
  EMPTY=""
  PATHS=()
  while [ $# -gt 0 ]; do
    case "$1" in
    --model) MODEL="${2:-}"; shift 2 ;;
    --phase) PHASE="${2:-}"; shift 2 ;;
    --empty) EMPTY=1; shift ;;
    -F) MSG_FILE="${2:-}"; shift 2 ;;
    --) shift; PATHS+=("$@"); break ;;
    -*) die "Unknown option: $1" ;;
    *) PATHS+=("$1"); shift ;;
    esac
  done
  [ -n "$PHASE" ] || die "The phase is missing: pass --phase <phase> ($PHASES)."
  [[ " $PHASES " == *" $PHASE "* ]] || die "Unknown phase '$PHASE'. Phases: $PHASES."
  MODEL="${MODEL:-${GUTEXBERG_MODEL:-$(default_model)}}"
  [ -n "$MODEL" ] || die "No model: pass --model <id>, set GUTEXBERG_MODEL or a model in settings.json."
  if [ -z "$MSG_FILE" ] && [ "$CMD" = commit ]; then
    [ -t 0 ] && die "The message is missing: pass it on stdin (heredoc) or with -F <file>."
    MSG_FILE=$(mktemp)
    trap 'rm -f "$MSG_FILE"' EXIT
    cat >"$MSG_FILE"
  fi
}

stage_paths() {
  [ $# -eq 0 ] || git add -- "$@"
}

report() {
  git log -1 --format='%h %s'
  git diff-tree --no-commit-id --name-only -r HEAD | sed 's/^/  /'
}

flow_log() {
  [ -f "$FLOW_LOG" ] || return 0
  echo "$(date -Is) [gutexberg] $1 $(git log -1 --format='%h %s')" >>"$FLOW_LOG"
}

trailer() {
  echo "Co-authored-by: Copilot ($MODEL) <$COPILOT_EMAIL>"
}

require_staged() {
  git diff --cached --quiet && die "Nothing is staged."
  if git diff --cached --name-only | grep -qE '(^|/)\.adl/'; then
    die "Staged changes include .adl/ files, which are never committed. Unstage them."
  fi
  return 0
}

strip_existing_trailer() {
  grep -v "^Co-authored-by: Copilot" "$1" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
}

message_problems() {
  local file="$1" subject blank body
  subject=$(sed -n 1p "$file")
  blank=$(sed -n 2p "$file")
  body=$(sed -n '3,$p' "$file" | grep -v "^Co-authored-by: Copilot" | grep -v '^[[:space:]]*$' || true)
  [[ "$subject" =~ $CONVENTIONAL_RE ]] ||
    echo "Subject is not a Conventional Commit sentence without a trailing period: '$subject'"
  [ "${#subject}" -le 72 ] ||
    echo "Subject is ${#subject} characters, $((${#subject} - 72)) over the limit of 72: '$subject'"
  [ -z "$blank" ] || echo "Line 2 of the message must be blank."
  [ -n "$body" ] || echo "The message needs a body after the blank line."
  return 0
}

validate_message() {
  local file="$1" problems
  [ -f "$file" ] || die "Message file '$file' not found."
  problems=$(message_problems "$file")
  [ -z "$problems" ] || die "$problems"
}

check_message() {
  local file="" problems subject
  while [ $# -gt 0 ]; do
    case "$1" in
    -F) file="${2:-}"; shift 2 ;;
    *) die "Usage: gutexberg check-message [-F <file>] <<'MSG'" ;;
    esac
  done
  if [ -z "$file" ]; then
    [ -t 0 ] && die "The message is missing: pass it on stdin (heredoc) or with -F <file>."
    CHECK_FILE=$(mktemp)
    trap 'rm -f "$CHECK_FILE"' EXIT
    file=$CHECK_FILE
    cat >"$file"
  fi
  [ -f "$file" ] || die "Message file '$file' not found."
  problems=$(message_problems "$file")
  [ -z "$problems" ] || die "$problems"
  subject=$(sed -n 1p "$file")
  echo "ok (${#subject}/72)"
}

CMD="${1:-}"
[ -n "$CMD" ] || { usage; exit 1; }
shift

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not inside a git work tree."

# Write commands share the index: serialise them, so that parallel calls cannot
# mix their files into one commit.
case "$CMD" in
stage | stage-patch | unstage | commit | amend)
  exec 9>"$(git rev-parse --git-common-dir)/gutexberg.lock"
  flock 9
  ;;
esac

case "$CMD" in
-h | --help | help) usage ;;
base) base ;;
range)
  for sha in $(git rev-list "$(base)..HEAD"); do
    printf '%s %s %s\n' "$(git rev-parse --short "$sha")" "[$(phase_of "$sha")]" "$(git log -1 --format=%s "$sha")"
  done
  ;;
next) echo "last cycle commit: $(last_cycle_phase); allowed: $(allowed_after "$(last_cycle_phase)")" ;;
check-message) check_message "$@" ;;
stage)
  [ $# -ge 1 ] || die "Usage: gutexberg stage <path>..."
  git add -- "$@"
  ;;
stage-patch)
  [ $# -eq 1 ] || die "Usage: gutexberg stage-patch <patch-file>"
  git apply --cached --unidiff-zero --whitespace=nowarn "$1"
  ;;
unstage)
  if [ $# -eq 0 ]; then git reset -q; else git reset -q -- "$@"; fi
  ;;
commit)
  parse_commit_args "$@"
  current_branch_guard
  validate_message "$MSG_FILE"
  check_subject_scope "$PHASE" "$(sed -n 1p "$MSG_FILE")"
  cycle_guard "$PHASE" "$EMPTY"
  stage_paths "${PATHS[@]}"
  if [ -n "$EMPTY" ]; then
    git diff --cached --quiet || die "--empty commits nothing: unstage the staged changes first."
  else
    require_staged
    check_paths "$PHASE"
  fi
  { strip_existing_trailer "$MSG_FILE"; echo; trailer; } | git commit -q ${EMPTY:+--allow-empty} -F -
  record_phase "$PHASE"
  flow_log "$PHASE"
  report
  ;;
amend)
  parse_commit_args "$@"
  current_branch_guard
  git rev-list "$(base)..HEAD" | grep -qx "$(git rev-parse HEAD)" || die "HEAD is outside the branch: refusing to amend."
  head_phase=$(phase_of "$(git rev-parse HEAD)")
  case "$head_phase" in
  red | regression | characterisation) ;;
  *) die "Only a red, regression or characterisation HEAD can be amended; HEAD is '${head_phase:-unrecorded}'." ;;
  esac
  [ "$PHASE" = "$head_phase" ] || die "HEAD is a $head_phase commit, not $PHASE."
  stage_paths "${PATHS[@]}"
  require_staged
  check_paths "$PHASE"
  git commit -q --amend --no-edit
  record_phase "$PHASE"
  flow_log "amend $PHASE"
  report
  ;;
*) usage; exit 1 ;;
esac
