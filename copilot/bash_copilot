# Autonomy of the Copilot workflow agents: 0 asks the user, 1 lets the agent
# proceed on its own. Read live by ~/.copilot/hooks/scripts/auto_approve.py
# and by the agents, so changes apply without restarting.
#   AUTONOMY_LINUS      commits, fixups and amends
#   AUTONOMY_UNCLEBOB   unclebob's edits of the code (tests and production)
#   AUTONOMY_ARGYRIS    argyris's changes to agent and skill files, its mirror
#                       commits in minime included
#   COPILOT_CONTAINERS  containers (docker, docker compose and their aliases
#                       in ~/.config/minime/aliases.toml) where agents may run
#                       commands, separated by spaces
export AUTONOMY_LINUS=1
export AUTONOMY_UNCLEBOB=1
export AUTONOMY_ARGYRIS=0
export COPILOT_CONTAINERS=""
